{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}-fabric",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "sources": "https://github.com/Rebel459/music-and-melody"
  },
  "license": "${license}",
  "icon": "assets/music_and_melody/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.rebel459.music_and_melody.MusicAndMelodyFabric"
    ],
    "client": [
      "net.rebel459.music_and_melody.MusicAndMelodyFabricClient"
    ],
    "modmenu": [
      "net.rebel459.music_and_melody.config.MaMModMenuIntegration"
    ]
  },
  "mixins": [
    "music_and_melody.mixins.json",
    "music_and_melody-fabric.mixins.json"
  ],
  "accessWidener": "music_and_melody.classtweaker",
  "depends": {
    "fabricloader": ">=0.18",
    "fabric-api": "*",
    "minecraft": "${fabric_minecraft_version}",
    "java": ">=25",
    "unified": "*",
    "cloth-config": "*"
  }
}