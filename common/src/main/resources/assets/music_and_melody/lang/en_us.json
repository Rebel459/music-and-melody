  "text.autoconfig.music_and_melody.option.client.music_rebalance": "Music Rebalance",
  "text.autoconfig.music_and_melody.option.client.music_rebalance.@Tooltip": "Whether vanilla and supported modded music pools should be completely reweighted. Certain albums may depend on this being enabled",
  "text.autoconfig.music_and_melody.option.client.jukebox_fading": "Jukebox Fading",
  "text.autoconfig.music_and_melody.option.client.jukebox_fading.@Tooltip": "Whether background music should fade away when a Jukebox is used, in order to avoid music overlap",
  "text.autoconfig.music_and_melody.option.client.fade_speed": "Fade Speed",
  "text.autoconfig.music_and_melody.option.client.fade_speed.@Tooltip": "The rate at which background music fades in and out when records are played",
  "text.autoconfig.music_and_melody.option.client.creative_fix": "Creative Fix",
  "text.autoconfig.music_and_melody.option.client.creative_fix.@Tooltip": "Whether to fix MC-299683, which makes creative music unable to play in many Overworld biomes",
  "text.autoconfig.music_and_melody.option.client.under_water_fix": "Under Water Fix",
  "text.autoconfig.music_and_melody.option.client.under_water_fix.@Tooltip": "Whether to fix MC-306710 and enforce that all rivers and oceans utilise the under_water music pool",
  "text.autoconfig.music_and_melody.option.client.event_weight_fix": "Event Weight Fix",
  "text.autoconfig.music_and_melody.option.client.event_weight_fix.@Tooltip": "Whether sounds.json event references should use their actual weight when a weight is explicitly provided",
  "text.autoconfig.music_and_melody.option.client.wither_music": "Wither Music",
  "text.autoconfig.music_and_melody.option.client.wither_music.@Tooltip": "Whether fighting the Wither should play Wither Storm Theme by Antimo & Welles",
  "text.autoconfig.music_and_melody.option.client.end_portal_music": "End Portal Music",
  "text.autoconfig.music_and_melody.option.client.end_portal_music.@Tooltip": "Whether lighting an End Portal should play Threshold by Soul_",
  "text.autoconfig.music_and_melody.option.client.common_music": "Common Music",
  "text.autoconfig.music_and_melody.option.client.common_music.@Tooltip": "Whether a pool of common Overworld music (contains classic C418 tracks by default) should be mixed with all pools which previously contained any common music entries",
  "text.autoconfig.music_and_melody.option.client.common_music_chance": "Common Music Chance",
  "text.autoconfig.music_and_melody.option.client.common_music_chance.@Tooltip": "The % chance of the common music pool being selected in favour of a music pool which would normally contain music from the common pool",
