  "text.autoconfig.music_and_melody/client.option.music_rebalance.@Tooltip": "Whether vanilla and supported modded music pools should be completely reweighted. Certain albums may depend on this being enabled",
  "text.autoconfig.music_and_melody/client.option.jukebox_fading": "Jukebox Fading",
  "text.autoconfig.music_and_melody/client.option.jukebox_fading.@Tooltip": "Whether background music should fade away when a Jukebox is used, in order to avoid music overlap",
  "text.autoconfig.music_and_melody/client.option.fade_speed": "Fade Speed",
  "text.autoconfig.music_and_melody/client.option.fade_speed.@Tooltip": "The rate at which music should fade in and out when Jukeboxes are played and between Events",
  "text.autoconfig.music_and_melody/client.option.creative_fix": "Creative Fix",
  "text.autoconfig.music_and_melody/client.option.creative_fix.@Tooltip": "Whether to fix MC-299683, which makes creative music unable to play in many Overworld biomes",
  "text.autoconfig.music_and_melody/client.option.under_water_fix": "Under Water Fix",
  "text.autoconfig.music_and_melody/client.option.under_water_fix.@Tooltip": "Whether to fix MC-306710 and enforce that all rivers and oceans utilise the under_water music pool",
  "text.autoconfig.music_and_melody/client.option.pool_weight_fix": "Pool Weight Fix",
  "text.autoconfig.music_and_melody/client.option.pool_weight_fix.@Tooltip": "Whether sounds.json pools should use their actual weight when a weight is explicitly provided",
  "text.autoconfig.music_and_melody/client.option.pause_button": "Pause Button",
  "text.autoconfig.music_and_melody/client.option.pause_button.@Tooltip": "REPLACE -> squishes between Give Feedback and Report Bugs. APPEND -> adds to the right of Statistics. NONE -> disabled",
  "text.autoconfig.music_and_melody/client.option.title_button": "Title Button",
  "text.autoconfig.music_and_melody/client.option.title_button.@Tooltip": "REPLACE -> replaces the Accessibility button. APPEND -> adds to the right of the Accessibility button. NONE -> disabled",
  "text.autoconfig.music_and_melody/client.option.automatic_discs": "Automatic Discs",
  "text.autoconfig.music_and_melody/client.option.automatic_discs.@Tooltip": "Whether the Mod Discs album should be added for detected music discs not already part of any album",
  "text.autoconfig.music_and_melody/client.option.allow_events": "Allow Events",
  "text.autoconfig.music_and_melody/client.option.allow_events.@Tooltip": "Whether the Events system should function. Disabling this completely disables Music and Melody's event system, rather than just stopping playback from it",
  "text.autoconfig.music_and_melody/client.option.vanilla_music": "Vanilla Music",
  "text.autoconfig.music_and_melody/client.option.vanilla_music.@Tooltip": "Whether vanilla music should be enabled. Disable this if you only want to hear music from your Playlist and Events",
  "text.autoconfig.music_and_melody/client.option.online_functionality": "Online Functionality",
  "text.autoconfig.music_and_melody/client.option.online_functionality.@Tooltip": "Whether online functionality, including the Online Browser, News and other internet-dependant features should be enabled",

  "text.autoconfig.music_and_melody/server.title": "Server",
  "text.autoconfig.music_and_melody/server.option.disc_unlocking": "Disc Unlocking",
  "text.autoconfig.music_and_melody/server.option.disc_unlocking.@Tooltip": "Whether music discs should have to be unlocked for survival players by using the disc in a Jukebox at least once",
  "text.autoconfig.music_and_melody/server.option.sync_structures": "Sync Structures",
  "text.autoconfig.music_and_melody/server.option.sync_structures.@Tooltip": "Whether the server should send clients the list of structures at the player's position. Required by structure and structure_tag Event conditions",
  "text.autoconfig.music_and_melody/server.option.improved_pve_detection": "Improved PvE Detection",
  "text.autoconfig.music_and_melody/server.option.improved_pve_detection.@Tooltip": "Whether the server should send clients more accurate entity tracking data. Improves the accuracy of the pve_score Event condition"
}
