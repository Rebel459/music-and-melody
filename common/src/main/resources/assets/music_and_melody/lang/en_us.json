  "text.autoconfig.music_and_melody/client.option.music_rebalance": "Music Rebalance",
  "text.autoconfig.music_and_melody/client.option.music_rebalance.@Tooltip": "Whether vanilla and supported modded music pools should be completely reweighted. Certain albums may depend on this being enabled",
  "text.autoconfig.music_and_melody/client.option.jukebox_fading": "Jukebox Fading",
  "text.autoconfig.music_and_melody/client.option.jukebox_fading.@Tooltip": "Whether background music should fade away when a Jukebox is used, in order to avoid music overlap",
  "text.autoconfig.music_and_melody/client.option.fade_speed": "Fade Speed",
  "text.autoconfig.music_and_melody/client.option.fade_speed.@Tooltip": "The rate at which background music fades in and out when records are played",
  "text.autoconfig.music_and_melody/client.option.creative_fix": "Creative Fix",
  "text.autoconfig.music_and_melody/client.option.creative_fix.@Tooltip": "Whether to fix MC-299683, which makes creative music unable to play in many Overworld biomes",
  "text.autoconfig.music_and_melody/client.option.under_water_fix": "Under Water Fix",
  "text.autoconfig.music_and_melody/client.option.under_water_fix.@Tooltip": "Whether to fix MC-306710 and enforce that all rivers and oceans utilise the under_water music pool",
  "text.autoconfig.music_and_melody/client.option.event_weight_fix": "Event Weight Fix",
  "text.autoconfig.music_and_melody/client.option.event_weight_fix.@Tooltip": "Whether sounds.json event references should use their actual weight when a weight is explicitly provided",
  "text.autoconfig.music_and_melody/client.option.wither_music": "Wither Music",
  "text.autoconfig.music_and_melody/client.option.wither_music.@Tooltip": "Whether fighting the Wither should play Wither Storm Theme by Antimo & Welles",
  "text.autoconfig.music_and_melody/client.option.end_portal_music": "End Portal Music",
  "text.autoconfig.music_and_melody/client.option.end_portal_music.@Tooltip": "Whether lighting an End Portal should play Threshold by Soul_",
  "text.autoconfig.music_and_melody/client.option.common_music": "Common Music",
  "text.autoconfig.music_and_melody/client.option.common_music.@Tooltip": "Whether a pool of common Overworld music (contains classic C418 tracks by default) should be mixed with all pools which previously contained any common music entries",
  "text.autoconfig.music_and_melody/client.option.common_music_chance": "Common Music Chance",
  "text.autoconfig.music_and_melody/client.option.common_music_chance.@Tooltip": "The % chance of the common music pool being selected in favour of a music pool which would normally contain music from the common pool",
  "text.autoconfig.music_and_melody/client.option.background_music": "Background Music",
  "text.autoconfig.music_and_melody/client.option.background_music.@Tooltip": "Whether background music should be enabled. Disable this if you only want music to play from your Playlist",
  "text.autoconfig.music_and_melody/client.option.button_positions": "Button Positions",
  "text.autoconfig.music_and_melody/client.option.button_positions.@Tooltip": "Where the Albums and Playlist buttons should be displayed. Can be SOUNDS, OPTIONS or NONE",
  "text.autoconfig.music_and_melody/client.option.custom_album": "Custom Album",
  "text.autoconfig.music_and_melody/client.option.custom_album.@Tooltip": "Where the custom Album, consisting of all .ogg files in config/music_and_melody/album and all registered, Album-less music discs, should be used",
  "text.autoconfig.music_and_melody/client.option.event_music_min": "Event Music Min",
  "text.autoconfig.music_and_melody/client.option.event_music_min.@Tooltip": "The minimum amount of time (in seconds) before new event music is played",
  "text.autoconfig.music_and_melody/client.option.event_music_max": "Event Music Max",
  "text.autoconfig.music_and_melody/client.option.event_music_max.@Tooltip": "The maximum amount of time (in seconds) before new event music is played",


  "text.autoconfig.music_and_melody/server.title": "Server",
  "text.autoconfig.music_and_melody/server.option.count_disc_uses": "Count Disc Uses",
  "text.autoconfig.music_and_melody/server.option.count_disc_uses.@Tooltip": "Whether using a Music Disc in a Jukebox should count as using it for world statistics",
  "text.autoconfig.music_and_melody/server.option.biome_music": "Biome Music",
  "text.autoconfig.music_and_melody/server.option.biome_music.@Tooltip": "A list of biome-specific music pools to be applied",
  "text.autoconfig.music_and_melody/server.option.structure_music": "Structure Music",
  "text.autoconfig.music_and_melody/server.option.structure_music.@Tooltip": "A list of structure-specific music pools to be applied",
  "text.autoconfig.music_and_melody/server.option.structure_music_min": "Structure Music Min",
  "text.autoconfig.music_and_melody/server.option.structure_music_min.@Tooltip": "The minimum amount of time (in seconds) before new structure music is played",
  "text.autoconfig.music_and_melody/server.option.structure_music_max": "Structure Music Max",
  "text.autoconfig.music_and_melody/server.option.structure_music_max.@Tooltip": "The maximum amount of time (in seconds) before new structure music is played",

