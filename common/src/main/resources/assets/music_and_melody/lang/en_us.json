  "text.autoconfig.music_and_melody/client.option.music_rebalance": "Music Rebalance",
  "text.autoconfig.music_and_melody/client.option.music_rebalance.@Tooltip": "Whether vanilla and supported modded music pools should be completely reweighted. Certain albums may depend on this being enabled",
  "text.autoconfig.music_and_melody/client.option.jukebox_fading": "Jukebox Fading",
  "text.autoconfig.music_and_melody/client.option.jukebox_fading.@Tooltip": "Whether background music should fade away when a Jukebox is used, in order to avoid music overlap",
  "text.autoconfig.music_and_melody/client.option.fade_speed": "Fade Speed",
  "text.autoconfig.music_and_melody/client.option.fade_speed.@Tooltip": "The rate at which music should fade in and out when Jukeboxes are played and between Events",
  "text.autoconfig.music_and_melody/client.option.pool_weight_fix": "Pool Weight Fix",
  "text.autoconfig.music_and_melody/client.option.pool_weight_fix.@Tooltip": "Whether sounds.json pools should use their actual weight when a weight is explicitly provided",
  "text.autoconfig.music_and_melody/client.option.button_placement": "Button Placement",
  "text.autoconfig.music_and_melody/client.option.button_placement.@Tooltip": "Where the Albums and Playlist buttons should be placed within the Sounds screen. Can be TOP, BOTTOM or NONE",
  "text.autoconfig.music_and_melody/client.option.config_album": "Config Album",
  "text.autoconfig.music_and_melody/client.option.config_album.@Tooltip": "Whether the config-driven Album, consisting of all .ogg files in config/music_and_melody/album and all registered, Album-less music discs, should be used",
  "text.autoconfig.music_and_melody/client.option.allow_events": "Allow Events",
  "text.autoconfig.music_and_melody/client.option.allow_events.@Tooltip": "Whether the Events system should function. Disable this if you only want to hear music from your Playlist or from vanilla's music system",
  "text.autoconfig.music_and_melody/client.option.vanilla_music": "Vanilla Music",
  "text.autoconfig.music_and_melody/client.option.vanilla_music.@Tooltip": "Whether vanilla music should be enabled. Disable this if you only want to hear music from your Playlist and Events",
  "text.autoconfig.music_and_melody/client.option.remote_downloads": "Remote Downloads",
  "text.autoconfig.music_and_melody/client.option.remote_downloads.@Tooltip": "Whether downloadable content should appear in the browser",
  "text.autoconfig.music_and_melody/client.option.remote_repositories": "Remote Repositories",
  "text.autoconfig.music_and_melody/client.option.remote_repositories.@Tooltip": "A list of repositories to scan for downloadable Albums",

  "text.autoconfig.music_and_melody/server.title": "Server",
  "text.autoconfig.music_and_melody/server.option.count_disc_uses": "Count Disc Uses",
  "text.autoconfig.music_and_melody/server.option.count_disc_uses.@Tooltip": "Whether using a Music Disc in a Jukebox should count as using it for world statistics",
  "text.autoconfig.music_and_melody/server.option.sync_structures": "Sync Structures",
  "text.autoconfig.music_and_melody/server.option.sync_structures.@Tooltip": "Whether the server should send the client a list of structures for the player's position. Required by Event structure conditions",
