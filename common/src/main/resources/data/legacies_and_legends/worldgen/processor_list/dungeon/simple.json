{
  "processors": [
    {
      "processor_type": "minecraft:rule",
      "rules": [
        {
          "location_predicate": {
            "predicate_type": "minecraft:always_true"
          },
          "input_predicate": {
            "predicate_type": "minecraft:random_block_match",
            "block": "minecraft:cobblestone",
            "probability": 0.4
          },
          "output_state": {
            "Name": "minecraft:mossy_cobblestone"
          }
        },
        {
          "location_predicate": {
            "predicate_type": "minecraft:always_true"
          },
          "input_predicate": {
            "predicate_type": "minecraft:random_block_match",
            "block": "minecraft:chest",
            "probability": 0.4
          },
          "output_state": {
            "Name": "minecraft:air"
          }
        }
      ]
    },
    {
      "processor_type": "lithostitched:condition",
      "if_true": {
        "type": "lithostitched:all_of",
        "conditions": [
          {
            "type": "lithostitched:matching_blocks",
            "blocks": "minecraft:cobblestone_stairs"
          },
          {
            "type": "lithostitched:random_chance",
            "chance": 0.4
          }
        ]
      },
      "then": [
        {
          "processor_type": "lithostitched:block_swap",
          "blocks": {
            "minecraft:cobblestone_stairs": "minecraft:mossy_cobblestone_stairs"
          }
        }
      ]
    },
    {
      "processor_type": "minecraft:protected_blocks",
      "value": "#legacies_and_legends:dungeon_protected"
    }
  ]
}
